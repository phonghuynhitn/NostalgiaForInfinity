# Copy to secrets/nfi-meme.env and replace all CHANGE_ME values.
# The copied .env file is ignored by git.

FREQTRADE__EXCHANGE__NAME=binance
FREQTRADE__EXCHANGE__KEY=CHANGE_ME_NFI_MEME_BINANCE_API_KEY
FREQTRADE__EXCHANGE__SECRET=CHANGE_ME_NFI_MEME_BINANCE_API_SECRET
# FREQTRADE__EXCHANGE__PASSWORD=CHANGE_ME_NFI_MEME_BINANCE_API_PASSWORD

FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=CHANGE_ME_NFI_MEME_TELEGRAM_BOT_TOKEN
FREQTRADE__TELEGRAM__CHAT_ID=CHANGE_ME_NFI_MEME_TELEGRAM_CHAT_ID

# Disable CoinGecko fiat conversion (4 bots share one IP rate limit).
FREQTRADE__FIAT_DISPLAY_CURRENCY=

FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__USERNAME=CHANGE_ME_NFI_MEME_API_USERNAME
FREQTRADE__API_SERVER__PASSWORD=CHANGE_ME_NFI_MEME_API_PASSWORD
FREQTRADE__API_SERVER__JWT_SECRET_KEY=CHANGE_ME_NFI_MEME_RANDOM_JWT_SECRET
FREQTRADE__API_SERVER__WS_TOKEN=CHANGE_ME_NFI_MEME_RANDOM_WS_TOKEN

# Uncomment only when this bot is ready to trade live.
# FREQTRADE__DRY_RUN=false
